	chapter.685635B154063850.title: "16 — Logistics and Freight"
	chapter.685635B154063850.chapter_subtitle: ["Turn production into a physical network of warehouses, packages and rail-served industry."]
	quest.4478698D1127B0E0.title: "Warehouse Discipline"
	quest.4478698D1127B0E0.quest_desc: ["Build a dedicated storage district instead of letting every workshop become a chest maze."]
	quest.151FCD909A01912D.title: "Funnels and Chutes"
	quest.151FCD909A01912D.quest_desc: ["Use Create routing components to move materials predictably between machines and buffers."]
	quest.57387C6D5C875527.title: "Warehouse Zones"
	quest.57387C6D5C875527.quest_desc: ["Divide storage into receiving, bulk stock, production inputs and finished goods."]
	quest.4136DF69582D3FA4.title: "Belt Distribution"
	quest.4136DF69582D3FA4.quest_desc: ["Build a belt line that serves more than one process and can be maintained without tearing the factory apart."]
	quest.0F9BCECF0214A540.title: "Item Vault Buffering"
	quest.0F9BCECF0214A540.quest_desc: ["Use bulk buffers so production can continue when downstream machines pause."]
	quest.1D70FF61E2641697.title: "Throughput Test"
	quest.1D70FF61E2641697.quest_desc: ["Move a sustained stream of items through funnels, chutes and belts without hand-carrying them."]
