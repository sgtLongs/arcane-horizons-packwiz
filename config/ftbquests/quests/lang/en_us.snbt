	quest.0D9808B5473379C7.title: "Package Addressing"
	quest.0D9808B5473379C7.quest_desc: ["Create a small package network with clear destinations and repeatable routing."]
	quest.6BF662D27ADEE9EE.title: "Remote Foundry"
