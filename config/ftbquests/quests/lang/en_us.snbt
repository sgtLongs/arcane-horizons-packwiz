	quest.797BABD82942A0CB.title: "Meta Logistics Network"
	quest.797BABD82942A0CB.quest_desc: ["Use Create: Meta Logistics to manage a remote or unloaded storage network while retaining physical transport."]
	quest.1CC4925D6F588091.title: "Freight Manifest"
	quest.1CC4925D6F588091.quest_desc: ["Move a useful shipment by train and record where it originated and where it was consumed."]
	quest.622E5780C93CC0F4.title: "Distribution Hub"
	quest.622E5780C93CC0F4.quest_desc: ["Create a central hub that receives, stores and dispatches goods to multiple destinations."]
	quest.3ED0CBECD79E10BA.title: "Remote Consumer"
	quest.3ED0CBECD79E10BA.quest_desc: ["Supply a factory or farm that is physically separated from the central warehouse."]
	quest.0A3C3B304B1B13AA.title: "Network Stress Test"
	quest.0A3C3B304B1B13AA.quest_desc: ["Run several producers and consumers at once and fix the first real bottleneck you find."]
	quest.60052179A45E175A.title: "Regional Supply Chain"
	quest.60052179A45E175A.quest_desc: ["Maintain at least three specialized sites connected through a deliberate logistics network."]
	chapter.0167628C8CDBAB18.title: "17 — Husbandry and Wildlife"
	chapter.0167628C8CDBAB18.chapter_subtitle: ["Make animal care, genetics and ecological fieldwork meaningful support professions."]
	quest.1205B5ED2BE0AA7B.title: "Ranch Site"
	quest.1205B5ED2BE0AA7B.quest_desc: ["Build a real ranch with room for feeding, water, breeding and animal separation."]
	quest.1E9D67AF6E07E59F.title: "Naturalist Fieldwork"
	quest.1E9D67AF6E07E59F.quest_desc: ["Document several wild Naturalist species in their proper habitats without turning every encounter into hunting."]
	quest.4391A052F2ADF1D3.title: "Feeding Troughs"
	quest.4391A052F2ADF1D3.quest_desc: ["Use Animal Husbandry feeding infrastructure so care becomes systematic rather than repetitive hand-feeding."]
	quest.3CFB6B00896B5852.title: "Wildlife Census"
	quest.3CFB6B00896B5852.quest_desc: ["Document several Naturalist species without treating every encounter as a hunt."]
	quest.26DA9A94260CA196.title: "Domestication"
	quest.26DA9A94260CA196.quest_desc: ["Raise livestock long enough to engage with domestication and happiness rather than treating animals as disposable resources."]
	quest.571AF68781276BD4.title: "Clean Water and Feed"
	quest.571AF68781276BD4.quest_desc: ["Keep feeding and water infrastructure stocked as routine ranch maintenance."]
	quest.1C1005AD09E8A6AF.title: "Breeding Records"
	quest.1C1005AD09E8A6AF.quest_desc: ["Begin tracking parents and offspring instead of breeding whichever two animals are closest."]
	quest.2506D7AB56ED535B.title: "Animal Health"
	quest.2506D7AB56ED535B.quest_desc: ["Recognize sickness or poor care and maintain a healthy herd."]
	quest.628E79D3D3299583.title: "Genetic Diversity"
	quest.628E79D3D3299583.quest_desc: ["Avoid close inbreeding and preserve multiple bloodlines in an important livestock species."]
	quest.1666EF07429D1313.title: "Lineage Book"
	quest.1666EF07429D1313.quest_desc: ["Track breeding pairs far enough to avoid repeatedly breeding close relatives."]
	quest.502EBA566F508553.title: "Quarantine Pen"
	quest.502EBA566F508553.quest_desc: ["Reserve a separate enclosure for sick, new or selectively bred animals."]
	quest.286C0B098941ABCD.title: "Selected Traits"
	quest.286C0B098941ABCD.quest_desc: ["Breed deliberately for a useful trait or improved animal rather than raw population growth."]
	quest.5AA16125A3288DD2.title: "Cattle Economy"
	quest.5AA16125A3288DD2.quest_desc: ["Maintain cattle as a source of food, milk, leather and breeding stock that feeds several progression systems."]
	quest.123D5186EEE4BD5E.title: "Trait Project"
	quest.123D5186EEE4BD5E.quest_desc: ["Choose one useful inherited trait and breed deliberately toward it."]
	quest.08632EB0AF2D909E.title: "Pigs and Truffles"
	quest.08632EB0AF2D909E.quest_desc: ["Use pigs for more than meat by engaging with their husbandry-specific behavior and truffle role."]
	quest.10A8231E2BC75E99.title: "Sheep and Textiles"
	quest.10A8231E2BC75E99.quest_desc: ["Maintain a sheep line that supports wool, beds, decoration and textile-heavy infrastructure."]
	quest.569E6724D0E66CD1.title: "Dairy and Leather Run"
	quest.569E6724D0E66CD1.quest_desc: ["Operate cattle as a renewable production system rather than a disposable meat source."]
	quest.04559CB7AB22DA24.title: "Working Landscape"
	quest.04559CB7AB22DA24.quest_desc: ["Maintain productive livestock and a healthy surrounding ecosystem as part of a mature settlement."]
	quest.2958FCEAE0AFB874.title: "Wool Works"
	quest.2958FCEAE0AFB874.quest_desc: ["Connect sheep production to textiles, beds, decoration or another settlement need."]
	chapter.18B6E0F5D7D87844.title: "18 — Angler’s Field Guide"
	chapter.18B6E0F5D7D87844.chapter_subtitle: ["Turn Aquaculture into a travel, food, equipment and rare-resource profession."]
	quest.4600A366EEA6E512.title: "Tackle Station"
	quest.4600A366EEA6E512.quest_desc: ["Establish a permanent fishing station with spare rods, food, storage and tackle."]
	quest.5E11B18986A07C16.title: "Bait and Tackle"
	quest.5E11B18986A07C16.quest_desc: ["Use Aquaculture tackle and bait intentionally instead of relying only on a vanilla rod."]
	quest.5191E3DD058A4833.title: "Tackle Loadout"
	quest.5191E3DD058A4833.quest_desc: ["Assemble a specialized fishing kit before leaving the settlement."]
	quest.0FC0C0864F283796.title: "Freshwater Species Census"
	quest.0FC0C0864F283796.quest_desc: ["Catch a deliberately broad freshwater selection and identify which habitats produce the species you still need."]
	quest.32FAF4E67DC7F10A.title: "Coastal Species Census"
	quest.32FAF4E67DC7F10A.quest_desc: ["Build a deliberate coastal and ocean species collection beyond the introductory fishing survey."]
	quest.7445B14FD6393533.title: "Cold-Water Expedition"
	quest.7445B14FD6393533.quest_desc: ["Travel specifically to cold aquatic biomes for species unavailable near home."]
	quest.172A071A8BB868D9.title: "Warm-Water Expedition"
	quest.172A071A8BB868D9.quest_desc: ["Travel specifically to warm aquatic biomes for a different catch profile."]
	quest.536034B28720B257.title: "Cutting Board Processing"
	quest.536034B28720B257.quest_desc: ["Process modded fish through Farmer’s Delight-compatible cutting using Aquacompat."]
	quest.67317E8FED044A00.title: "River and Lake Creel"
	quest.67317E8FED044A00.quest_desc: ["Catch a deliberately varied set of freshwater fish rather than repeating the foundation survey."]
	quest.4855978B7B5525EC.title: "Coastal Creel"
	quest.4855978B7B5525EC.quest_desc: ["Build a varied coastal and ocean catch rather than repeating the introductory survey."]
	quest.1307F6416F80F2E7.title: "Deep-Water Fishing"
	quest.1307F6416F80F2E7.quest_desc: ["Prepare for dangerous deep-ocean fishing rather than treating every shoreline as equivalent."]
	quest.68C9F44C12CB6C01.title: "Aquaculture Delight Kitchen"
	quest.68C9F44C12CB6C01.quest_desc: ["Turn catches into proper meals through Aquaculture Delight rather than consuming raw/simple fish."]
	quest.04691A0306319105.title: "Temperature Specialist"
	quest.04691A0306319105.quest_desc: ["Complete catches in both cold-water and warm-water environments."]
	quest.2E0362B4D80C0180.title: "Rare Catch Collection"
	quest.2E0362B4D80C0180.quest_desc: ["Pursue uncommon fish and treasures as collection and progression goals."]
	quest.59E009F229F7ABA9.title: "Fish Market"
	quest.59E009F229F7ABA9.quest_desc: ["Process and store several different catches as food ingredients for the settlement."]
	quest.7FB768421C4CDC97.title: "Neptunium Craft"
	quest.7FB768421C4CDC97.quest_desc: ["Advance into Aquaculture’s Neptunium equipment and use its advantages as a specialist angler."]
	quest.45D0BE0B778E9CFF.title: "Master Fishery"
	quest.45D0BE0B778E9CFF.quest_desc: ["Maintain a fishery that supplies cuisine, expeditions and apothecary ingredients while still rewarding travel."]
	quest.484CD31F4C5924C3.title: "Rare Catch Display"
	quest.484CD31F4C5924C3.quest_desc: ["Preserve a genuinely rare catch or Neptunium-related achievement as a trophy."]
	chapter.7B1155FE45F02AD8.title: "19 — Agriculture and Cuisine"
	chapter.7B1155FE45F02AD8.chapter_subtitle: ["Expand the support economy from subsistence crops to automated settlement-scale food production."]
	quest.09B31AA2916F01D9.title: "Crop Diversity"
	quest.09B31AA2916F01D9.quest_desc: ["Grow a deliberately diverse field rather than surviving on one staple crop."]
	quest.102219CDE7F8FF40.title: "Animal Feed Production"
	quest.102219CDE7F8FF40.quest_desc: ["Reserve agricultural output for livestock and ranch expansion rather than sending every crop to the kitchen."]
	quest.1DF18A27F2CFBE5D.title: "Expanded Delight Crops"
	quest.1DF18A27F2CFBE5D.quest_desc: ["Establish the additional crops from Expanded Delight as part of the settlement food economy."]
	quest.513FB67A4C286525.title: "Seed Bank"
	quest.513FB67A4C286525.quest_desc: ["Maintain spare seed stock for the expanded crop roster."]
	quest.00632D0590D8C4A4.title: "Feed Plot"
	quest.00632D0590D8C4A4.quest_desc: ["Dedicate part of the farm to livestock feed rather than player food."]
	quest.58F5745237868F71.title: "Pantry Standards"
	quest.58F5745237868F71.quest_desc: ["Maintain reserve ingredients so cooking does not stop every time an expedition consumes the last meal."]
	quest.08E3957EC5A619F0.title: "Cutting Board Mastery"
	quest.08E3957EC5A619F0.quest_desc: ["Use Farmer’s Delight preparation steps as part of real recipes rather than skipping directly to finished food."]
	quest.3BB301A2B6C0639C.title: "Prep Line"
	quest.3BB301A2B6C0639C.quest_desc: ["Organize cutting-board and ingredient storage so meals can be assembled efficiently."]
	quest.3E40D3DE40D4B155.title: "Create Slicer"
	quest.3E40D3DE40D4B155.quest_desc: ["Automate cutting-board style preparation with Create: Slice and Dice."]
	quest.40E45C03DFB50699.title: "Slicer Throughput"
	quest.40E45C03DFB50699.quest_desc: ["Automate a repeated cutting task with Slice and Dice."]
	quest.4357C1096B20F99B.title: "Mechanical Kitchen"
	quest.4357C1096B20F99B.quest_desc: ["Connect Create power and ingredient movement to a working food-production line."]
	quest.5034D283EC3219A2.title: "Combat Provisions"
	quest.5034D283EC3219A2.quest_desc: ["Prepare expensive food intended for difficult combat and boss attempts."]
	quest.3FED74ED8994DE9C.title: "Expedition Rations"
	quest.3FED74ED8994DE9C.quest_desc: ["Produce meals specifically chosen for long exploration and recovery rather than only hunger value."]
	quest.6EDE0F43323B1C81.title: "Bulk Preservation"
	quest.6EDE0F43323B1C81.quest_desc: ["Maintain enough prepared food to survive a long expedition or production interruption."]
	quest.4A6072656B84CC4E.title: "Settlement Kitchen"
	quest.4A6072656B84CC4E.quest_desc: ["Build a dedicated kitchen capable of feeding both players and supporting the wider settlement."]
	quest.6FBCCA58DAF551F5.title: "Ration Batch"
	quest.6FBCCA58DAF551F5.quest_desc: ["Produce expedition food in quantity for more than one trip."]
	quest.383CADC202B6BAE1.title: "Food Industry"
	quest.383CADC202B6BAE1.quest_desc: ["Automate meaningful portions of ingredient preparation while keeping high-tier meals dependent on diverse supply chains."]
	quest.61D5EE55D7AF597E.title: "Kitchen Supply Contract"
	quest.61D5EE55D7AF597E.quest_desc: ["Keep the settlement kitchen supplied from farms, ranches and fisheries at the same time."]
	chapter.59D509A33EEE2621.title: "20 — Apothecary"
	chapter.59D509A33EEE2621.chapter_subtitle: ["Build a dedicated healing and preparation profession from folk remedies to multi-school magical pharmacology."]
	quest.6AFC976D2BAB6186.title: "Herbal Cabinet"
	quest.6AFC976D2BAB6186.quest_desc: ["Collect and organize common plants, mushrooms, honey and other basic medicinal ingredients."]
	quest.68BF2AB92BDE9373.title: "Bee Products"
	quest.68BF2AB92BDE9373.quest_desc: ["Integrate honey, wax or specialized bee products into the apothecary supply chain."]
	quest.1255264E78DFCDC5.title: "Animal Ingredients"
	quest.1255264E78DFCDC5.quest_desc: ["Use responsibly sourced ranching products as medicinal or culinary inputs."]
	quest.6CC47775B8377E69.title: "Aquatic Ingredients"
	quest.6CC47775B8377E69.quest_desc: ["Reserve selected fishing products for oils, extracts or later alchemical recipes."]
	quest.7DB4D0FD86FB6060.title: "Folk Remedies"
	quest.7DB4D0FD86FB6060.quest_desc: ["Use food, herbs and simple preparations as the earliest recovery tools before advanced brewing."]
	quest.2978EFE6D9EEC026.title: "Herbarium"
	quest.2978EFE6D9EEC026.quest_desc: ["Collect and label the plants used most often in medicine and magic."]
	quest.2D34764D5C9A17CE.title: "Honey Medicine"
	quest.2D34764D5C9A17CE.quest_desc: ["Use bee products in a real healing, food or alchemical preparation."]
	quest.03FF85560FCD0624.title: "Ranch Reagents"
	quest.03FF85560FCD0624.quest_desc: ["Reserve useful animal products for medicine instead of consuming every output elsewhere."]
	quest.43C1300A5F752CB1.title: "Aquatic Reagents"
	quest.43C1300A5F752CB1.quest_desc: ["Set aside fish or aquatic products specifically for apothecary work."]
	quest.724F2E8BAF255611.title: "Drying and Grinding"
	quest.724F2E8BAF255611.quest_desc: ["Establish a repeatable preparation area for drying, cutting and grinding biological ingredients."]
	quest.7AC470612FF73216.title: "Hexerei Workshop"
	quest.7AC470612FF73216.quest_desc: ["Make Hexerei the practical witchcraft branch of the apothecary rather than an isolated magic tree."]
	quest.7795EC85D3201A86.title: "Nature’s Aura Reagents"
	quest.7795EC85D3201A86.quest_desc: ["Bring ecological magic into preparations that depend on healthy environments and renewable support systems."]
	quest.76B959EDE181B807.title: "Mortar Shelf"
	quest.76B959EDE181B807.quest_desc: ["Create a dedicated storage and processing area for dried and ground ingredients."]
	quest.72973D475A0F94A3.title: "Iron’s Alchemy"
	quest.72973D475A0F94A3.quest_desc: ["Connect Iron’s Spells alchemical or potion systems to combat preparation and expedition supply."]
	quest.64A0469E411B28F0.title: "Ars Infusion"
	quest.64A0469E411B28F0.quest_desc: ["Use Ars Source and imbuement as magical-processing tools for advanced reagents."]
	quest.34F52FDE047AF68A.title: "Occult Ingredients"
	quest.34F52FDE047AF68A.quest_desc: ["Use Occultism for rare ritual knowledge and ingredients without bypassing its intended ritual progression."]
	quest.313E7CCB487A83D1.title: "Mixing Cauldron"
	quest.313E7CCB487A83D1.quest_desc: ["Use the Hexerei Mixing Cauldron as a major step from folk preparation into deliberate magical mixtures."]
	quest.73D5A7D189912873.title: "Boss Preparations"
	quest.73D5A7D189912873.quest_desc: ["Prepare a complete set of food, medicine, magical consumables and replacements before a major boss attempt."]
	quest.1A7AC3184182D598.title: "Cauldron Batch"
	quest.1A7AC3184182D598.quest_desc: ["Prepare several doses of one useful Hexerei or potion mixture in a single planned session."]
	quest.0D22AD3A0BA565E6.title: "Cross-School Formula"
	quest.0D22AD3A0BA565E6.quest_desc: ["Complete one preparation that draws ingredients or infrastructure from multiple magic systems."]
	quest.3CAC92F3BEC83B07.title: "Boss Medicine Chest"
	quest.3CAC92F3BEC83B07.quest_desc: ["Stock a reusable chest of healing and resistance preparations for major encounters."]
	quest.4C16425A2F47899C.title: "Master Apothecary"
	quest.4C16425A2F47899C.quest_desc: ["Maintain a dedicated apothecary that pulls from farms, ranches, fishing, bees, wildlife and every mature magical school."]
	chapter.2E785984D419D8D0.title: "21 — Archaeology and Ancient Knowledge"
	chapter.2E785984D419D8D0.chapter_subtitle: ["Give ruins and suspicious sites a research path that feeds exploration, magic and late technology."]
	quest.3E020B28610AD0D0.title: "Field Brush"
	quest.3E020B28610AD0D0.quest_desc: ["Carry archaeology tools on expeditions so suspicious sites are opportunities rather than scenery."]
	quest.331E088CF64FD147.title: "Suspicious Sites"
	quest.331E088CF64FD147.quest_desc: ["Excavate multiple archaeology locations instead of opening every structure as a combat dungeon."]
	quest.6D72AF10C66CE350.title: "Dig Site Grid"
	quest.6D72AF10C66CE350.quest_desc: ["Survey an archaeological site systematically instead of excavating random blocks."]
	quest.11AE7E1FE530BD96.title: "Pottery Record"
	quest.11AE7E1FE530BD96.quest_desc: ["Build a collection of pottery evidence and treat duplicates as research material."]
	quest.0FEB7E7059BFA47F.title: "Archaeology Table"
	quest.0FEB7E7059BFA47F.quest_desc: ["Establish the Archeological research workstation and use it as part of settlement scholarship."]
	quest.44E43F4E9414F1C5.title: "Sherd Catalogue"
	quest.44E43F4E9414F1C5.quest_desc: ["Preserve pottery finds and keep duplicates or patterns organized."]
	quest.157FE4EA44CE6DD0.title: "Statues and Idols"
	quest.157FE4EA44CE6DD0.quest_desc: ["Recover representative statues or idols as research and collection milestones."]
	quest.7C80A3A654C4CF84.title: "Dark Urns"
	quest.7C80A3A654C4CF84.quest_desc: ["Explore dangerous depths specifically for archaeology content rather than only ore and combat loot."]
	quest.0B906A7F76DF9748.title: "Ancient Remains"
	quest.0B906A7F76DF9748.quest_desc: ["Recover and study ancient remains from the Archeological mod."]
	quest.10D4EF76523BC56C.title: "Petroglyph Survey"
	quest.10D4EF76523BC56C.quest_desc: ["Locate underground petroglyphs and document where ancient cultures left evidence."]
	quest.23836268A35A60D2.title: "Artifact Conservation"
	quest.23836268A35A60D2.quest_desc: ["Store valuable finds in a protected collection rather than immediately spending everything."]
	quest.629F865FA1B6C4EB.title: "Runestone Study"
	quest.629F865FA1B6C4EB.quest_desc: ["Recover and experiment with runestones as ancient magical technology."]
	quest.4496F9F4432E2233.title: "Ruins Archive"
	quest.4496F9F4432E2233.quest_desc: ["Record where important remains, petroglyphs or monuments were found."]
	quest.5CB81B93D0952632.title: "Runestone Rubbings"
	quest.5CB81B93D0952632.quest_desc: ["Document runestone discoveries before using them in progression."]
	quest.3F8ABE827842D284.title: "Ancient-Industry Link"
	quest.3F8ABE827842D284.quest_desc: ["Treat selected ancient materials or knowledge as inspiration for mature engineering rather than free high-tier components."]
	quest.38501B19A9410E0A.title: "Ancient-Magic Link"
	quest.38501B19A9410E0A.quest_desc: ["Connect archaeological discoveries to one of the established magical schools through quests and research."]
	quest.7F054853923A7C9F.title: "Industrial Interpretation"
	quest.7F054853923A7C9F.quest_desc: ["Connect one ancient find to metallurgy, engineering or logistics research."]
	quest.7EE108634B786623.title: "Museum of Horizons"
	quest.7EE108634B786623.quest_desc: ["Build a permanent archive or museum displaying major discoveries from several regions and dimensions."]
	quest.19CBBAF3613B264D.title: "Arcane Interpretation"
	quest.19CBBAF3613B264D.quest_desc: ["Connect one ancient find to Ars, Hexerei, Nature’s Aura, Iron’s Spells or Occultism."]
	chapter.63ED3B94F8A7B38C.title: "22 — Expedition Gear and Waystones"
	chapter.63ED3B94F8A7B38C.chapter_subtitle: ["Make carrying capacity and fast travel earned infrastructure rather than early-game shortcuts."]
	quest.61C7953B9FD55195.title: "Leather Pack"
	quest.61C7953B9FD55195.quest_desc: ["Earn the first practical backpack only after leather production is stable."]
	quest.7C4B50597186B15B.title: "Discover a Waystone"
	quest.7C4B50597186B15B.quest_desc: ["Treat generated Waystones as permanent destinations that reward exploration."]
	quest.05208399AA7BB8FA.title: "Copper Pack"
	quest.05208399AA7BB8FA.quest_desc: ["Advance portable storage alongside the Copper Age rather than jumping straight to huge inventories."]
	quest.7451038A291E477B.title: "Pack Weight Discipline"
	quest.7451038A291E477B.quest_desc: ["Choose a backpack tier appropriate to the expedition rather than treating portable storage as infinite capacity."]
	quest.2A7E4EF00AECF15B.title: "Permanent Network"
	quest.2A7E4EF00AECF15B.quest_desc: ["Use fixed discovered Waystones as infrastructure; do not relocate generated Waystones to convenience locations."]
	quest.6C8AFF7E29BC0149.title: "Waystone Survey"
	quest.6C8AFF7E29BC0149.quest_desc: ["Discover a generated Waystone and record its permanent location instead of moving it."]
	quest.10C4D005893E10E1.title: "Iron Pack"
	quest.10C4D005893E10E1.quest_desc: ["Upgrade only once iron production is established enough that the material is no longer a one-ingot miracle."]
	quest.2239F46CF043C7CA.title: "Travel Hub"
	quest.2239F46CF043C7CA.quest_desc: ["Integrate Waystones with roads, rail or settlement outposts so fast travel complements physical infrastructure."]
	quest.4EA7ED7BF6ECBF57.title: "Gold Pack"
	quest.4EA7ED7BF6ECBF57.quest_desc: ["Tie higher backpack tiers to post-Nether processed gold and precision infrastructure."]
	quest.24E7551B23A86071.title: "Backpack Upgrades"
	quest.24E7551B23A86071.quest_desc: ["Unlock backpack functionality gradually so portable storage does not invalidate warehouses and freight."]
	quest.1B5276FF06D3D4E8.title: "Diamond Pack"
	quest.1B5276FF06D3D4E8.quest_desc: ["Reserve large high-tier portable storage for mature industrial and dimensional progression."]
	quest.7192CE558732BE26.title: "Prepared Loadout"
	quest.7192CE558732BE26.quest_desc: ["Carry food, medicine, tools, replacement equipment and recovery supplies as a deliberate expedition kit."]
	quest.3A51B64697A25875.title: "Upgrade Restraint"
	quest.3A51B64697A25875.quest_desc: ["Install only upgrades that have been unlocked by the current technology tier."]
	quest.710B180ED25F8339.title: "Crafted Fast Travel"
	quest.710B180ED25F8339.quest_desc: ["Earn player-created fast travel only after conventional exploration, logistics and settlement infrastructure have mattered."]
	quest.2424DD6F019D3E6C.title: "Recovery Bag"
	quest.2424DD6F019D3E6C.quest_desc: ["Keep a small standardized replacement kit ready for recovering a grave."]
	chapter.199AE2C007A46782.title: "23 — Dimensional Ecology"
	chapter.199AE2C007A46782.chapter_subtitle: ["Give every existing dimension a distinct economic, magical and expedition identity."]
	quest.1377A24132850D56.title: "Aether Ecology"
	quest.1377A24132850D56.quest_desc: ["Study Aether plants, creatures and resources as a celestial ecosystem rather than only a dungeon dimension."]
	quest.0F20710647319049.title: "End Logistics"
	quest.0F20710647319049.quest_desc: ["Prepare the End as a long-duration expedition with storage and replacement equipment."]
	quest.422A9CAC6B73EE85.title: "Deep Dark Survey"
	quest.422A9CAC6B73EE85.quest_desc: ["Enter Ancient City and Deep Dark territory as a planned research mission rather than casual mining."]
	quest.29AA56E7429C91C3.title: "Nether Logistics"
	quest.29AA56E7429C91C3.quest_desc: ["Establish a safe supply route and staging area before using the Nether as routine industrial territory."]
	quest.713A8BFD9539909B.title: "Echo Sample Archive"
	quest.713A8BFD9539909B.quest_desc: ["Return Deep Dark materials to a protected research collection."]
	quest.35CECC75CC94EBE4.title: "Aether Specimen Program"
	quest.35CECC75CC94EBE4.quest_desc: ["Bring back flora, fauna products or materials for ecological and magical research."]
	quest.4005277871B9E094.title: "Aether Apothecary"
	quest.4005277871B9E094.quest_desc: ["Bring celestial biological ingredients into late apothecary and Nature’s Aura/Ars research."]
	quest.1214DE2F238B2D7F.title: "Aether Infrastructure"
	quest.1214DE2F238B2D7F.quest_desc: ["Establish a repeatable route, shelter and storage for sustained Aether expeditions."]
	quest.11F60D894392AE0B.title: "Shulker Economy"
	quest.11F60D894392AE0B.quest_desc: ["Turn shulker resources into a major logistics milestone instead of merely better boxes."]
	quest.131E4767408AD63F.title: "End Separation"
	quest.131E4767408AD63F.quest_desc: ["Connect End materials to the two-times metallurgy era and advanced separation technology."]
	quest.60E63D95705C8418.title: "Nether Industry"
	quest.60E63D95705C8418.quest_desc: ["Use blaze heat, quartz, brass and precision as the Nether’s defining contribution to technology."]
	quest.5434B75786A002B5.title: "Nether Supply Contract"
	quest.5434B75786A002B5.quest_desc: ["Maintain a repeatable flow of quartz, blaze materials or other Nether inputs back to industry."]
	quest.6A4527DB6C263A7B.title: "Nether Apothecary"
	quest.6A4527DB6C263A7B.quest_desc: ["Collect Nether-specific ingredients that expand brewing and high-risk combat preparation."]
	quest.3C480481C2D8EA1C.title: "Echo Research"
	quest.3C480481C2D8EA1C.quest_desc: ["Use echo/sculk resources as rare inputs for occult, apothecary or advanced magical work."]
	quest.7701DE3AC0F86742.title: "Aether Supply Line"
	quest.7701DE3AC0F86742.quest_desc: ["Move useful Aether resources into settlement storage without treating the dimension as a one-time trip."]
	quest.0535F7A367C6F914.title: "Shulker Logistics Trial"
	quest.0535F7A367C6F914.quest_desc: ["Use post-End storage or logistics materials in a real distribution system."]
	quest.24AC73DAA31D72C6.title: "Nether Field Pharmacy"
	quest.24AC73DAA31D72C6.quest_desc: ["Identify which Nether materials belong in the apothecary supply chain."]
	quest.70716417489C01D5.title: "Deeper and Darker Expedition"
	quest.70716417489C01D5.quest_desc: ["Treat the deeper dimension as a separate high-risk campaign with its own resupply requirements."]
	quest.6A812FC526CFDEDF.title: "Dimensional Supply Network"
	quest.6A812FC526CFDEDF.quest_desc: ["Maintain supplies or staging infrastructure for multiple dimensions at the same time."]
	quest.20FB7BCDEAE59706.title: "Other-side Staging Camp"
	quest.20FB7BCDEAE59706.quest_desc: ["Build a defensible staging point for Deeper and Darker exploration."]
	quest.645008AE21F6CBE5.title: "Interdimensional Ledger"
	quest.645008AE21F6CBE5.quest_desc: ["Track which dimension supplies which branch of the settlement economy."]
	quest.7812B1CBB06935BA.title: "Worlds as an Economy"
	quest.7812B1CBB06935BA.quest_desc: ["Use each dimension for a distinct set of resources and systems rather than treating them as isolated sightseeing content."]
}
